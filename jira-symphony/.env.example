# ── Jira · Symphony configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values, then: npm start
# Leave JIRA_* blank to run in MOCK mode (dashboard works, no real Jira).

# Your Jira site (no trailing slash)
JIRA_BASE_URL=https://artrecruitment.atlassian.net

# The email of the Jira account that owns the API token
JIRA_EMAIL=you@example.com

# Create one at: https://id.atlassian.net/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here

# Which tickets to watch. Default = tickets assigned to the token's owner.
# Examples:
#   assignee = currentUser() ORDER BY updated DESC
#   assignee = currentUser() AND project = KAN AND statusCategory != Done ORDER BY created DESC
JIRA_JQL=assignee = currentUser() ORDER BY updated DESC

# How often to poll Jira (seconds)
POLL_INTERVAL_SEC=15

# How many agents may run at once (backpressure cap)
MAX_CONCURRENT_AGENTS=4
# Size of the agent fleet shown on the dashboard
AGENTS=8

# Write back to Jira when an agent starts/finishes (needs write permission)
WRITE_BACK=true
# Status names your workflow uses (fuzzy-matched against available transitions)
STATUS_IN_PROGRESS=In Progress
STATUS_DONE=Done

# If true, dispatch tickets already assigned to you at startup.
# If false (default), only NEW assignments after startup trigger agents.
DISPATCH_EXISTING_ON_START=false

# Force mock mode even if credentials are present
JIRA_MOCK=false

# Web server port
PORT=4000
