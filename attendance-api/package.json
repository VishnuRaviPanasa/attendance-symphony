{
  "name": "attendance-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Attendance REST API. Routes are auto-discovered from routes/*.js — drop a file in and the endpoint goes live.",
  "scripts": {
    "start": "node --watch-path=./lib --watch-path=./data server.js",
    "start:plain": "node server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "check:routes": "node scripts/check-routes.mjs",
    "verify": "npm test && npm run check:routes"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2"
  }
}
